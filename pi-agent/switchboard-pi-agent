#!/usr/bin/python3
"""Switchboard's fixed command set on the Raspberry Pi.

Installed root-owned at /usr/local/bin/switchboard-pi-agent and bound to Switchboard's
SSH key with `restrict,command=...` in authorized_keys, so that key can run only this
file. The request arrives in SSH_ORIGINAL_COMMAND as `<command> [args]`; anything not
listed below is refused. Every subprocess uses a fixed argv (no shell) and every answer
is one JSON object on stdout.

Commands:
  snapshot                 host resources, temperature, throttling, failed units
  status [service]         systemd/docker state for one or all known services
  logs <service> <lines>   last 1-400 journal or container log lines
  checks                   DNS answers, Tailscale, Uptime Kuma monitors, pending updates
  restart <service>        restart an allowlisted service, then report its state
  refresh-updates          apt-get update (package lists only; installs nothing)
  ps5 status|wake|standby  PlayStation 5 power state; wake/standby need owner pairing
  dns-stats                AdGuard Home totals, daily series and top lists (read-only)
  dns-pause <1-120>         pause protection for a bounded number of minutes
  dns-resume               resume protection
  dns-querylog <1-200> <all|blocked> [search]  recent DNS queries
  dns-rules                filtering state, user rules and filter lists
  dns-rule <allow|block|remove> <domain>      edit one domain's user rules
  dns-filters-refresh      refresh blocking filter lists
  version                  agent version

Install: see pi-agent/README.md in the Switchboard repo.
"""

import base64
import json
import math
import os
import re
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

VERSION = "5"
SERVICES = {
    # name: (kind, target, restartable)
    "homebridge": ("systemd", "homebridge.service", True),
    "adguard": ("systemd", "AdGuardHome.service", True),
    "nginx": ("systemd", "nginx.service", True),
    "kuma": ("docker", "uptime-kuma", True),
    "tailscale": ("systemd", "tailscaled.service", False),  # restarting could cut remote access
    "ssh": ("systemd", "ssh.service", False),  # restarting could cut Switchboard off
    "docker": ("systemd", "docker.service", False),
}
KUMA_DB = "/opt/uptime-kuma/data/kuma.db"
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}


def run(argv, timeout=15):
    try:
        done = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, env=ENV, check=False
        )
        return done.returncode, done.stdout[:512 * 1024], done.stderr[:4096]
    except (OSError, subprocess.TimeoutExpired):
        return -1, "", "unavailable"


def sudo(argv, timeout=30):
    return run(["/usr/bin/sudo", "-n", *argv], timeout)


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def meminfo():
    fields = {}
    for line in read("/proc/meminfo").splitlines():
        key, _, value = line.partition(":")
        if value.strip().endswith("kB"):
            fields[key] = int(value.split()[0]) / 1024
    total, available = fields.get("MemTotal"), fields.get("MemAvailable")
    memory = {"total_mb": round(total or 0, 1), "available_mb": round(available or 0, 1)}
    if total and available is not None:
        memory["used_mb"] = round(total - available, 1)
    swap = {
        "total_mb": round(fields.get("SwapTotal", 0), 1),
        "free_mb": round(fields.get("SwapFree", 0), 1),
    }
    swap["used_mb"] = round(swap["total_mb"] - swap["free_mb"], 1)
    return memory, swap


def disk(path):
    try:
        info = os.statvfs(path)
    except OSError:
        return None
    total, free = info.f_blocks * info.f_frsize, info.f_bavail * info.f_frsize
    return {
        "name": path,
        "total_gb": round(total / 1024**3, 2),
        "free_gb": round(free / 1024**3, 2),
        "used_percent": round((total - free) / total * 100, 1) if total else 0,
    }


def processes():
    code, out, _ = run(["/bin/ps", "-eo", "pid=,pcpu=,rss=,comm="])
    rows = []
    for line in out.splitlines() if code == 0 else []:
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit():
            try:
                rows.append(
                    {
                        "pid": int(parts[0]),
                        "cpu_percent": float(parts[1]),
                        "rss_mb": round(int(parts[2]) / 1024, 1),
                        "name": parts[3][:64],
                    }
                )
            except ValueError:
                continue
    return rows


THROTTLE_BITS = {
    0: "under_voltage_now",
    1: "freq_capped_now",
    2: "throttled_now",
    3: "soft_temp_limit_now",
    16: "under_voltage_since_boot",
    17: "freq_capped_since_boot",
    18: "throttled_since_boot",
    19: "soft_temp_limit_since_boot",
}


def cpu_ticks():
    fields = [int(x) for x in read("/proc/stat").splitlines()[0].split()[1:]]
    idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
    return sum(fields), idle


def default_interface():
    for line in read("/proc/net/route").splitlines()[1:]:
        parts = line.split()
        if len(parts) > 2 and parts[1] == "00000000" and re.fullmatch(r"[a-z0-9]{1,15}", parts[0]):
            return parts[0]
    return None


def net_bytes(interface):
    base = f"/sys/class/net/{interface}/statistics/"
    try:
        return int(read(base + "rx_bytes")), int(read(base + "tx_bytes"))
    except ValueError:
        return None


def sample(seconds=1.0):
    """CPU busy % and default-interface throughput over the same short window."""
    interface = default_interface()
    total0, idle0 = cpu_ticks()
    net0 = net_bytes(interface) if interface else None
    started = time.monotonic()
    time.sleep(seconds)
    elapsed = time.monotonic() - started
    total1, idle1 = cpu_ticks()
    net1 = net_bytes(interface) if interface else None
    result = {}
    if total1 > total0:
        result["cpu_percent"] = round(100 * (1 - (idle1 - idle0) / (total1 - total0)), 1)
    if net0 and net1:
        result["network"] = {
            "interface": interface,
            "rx_bytes_per_s": round((net1[0] - net0[0]) / elapsed),
            "tx_bytes_per_s": round((net1[1] - net0[1]) / elapsed),
        }
    return result


def snapshot():
    load = read("/proc/loadavg").split()
    memory, swap = meminfo()
    result = {
        "hostname": os.uname().nodename,
        "kernel": os.uname().release,
        "uptime_s": round(float(read("/proc/uptime").split()[0] or 0)),
        "load_averages": [float(x) for x in load[:3]] if len(load) >= 3 else [],
        "cpu_count": os.cpu_count(),
        "memory": memory,
        "swap": swap,
        "disks": [d for d in (disk("/"), disk("/boot/firmware")) if d],
        "reboot_required": os.path.exists("/var/run/reboot-required"),
        **sample(),
    }
    code, out, _ = run(["/usr/bin/vcgencmd", "measure_temp"])
    if match := re.search(r"temp=([\d.]+)", out):
        result["temperature_c"] = float(match[1])
    code, out, _ = run(["/usr/bin/vcgencmd", "get_throttled"])
    if match := re.search(r"throttled=(0x[0-9a-fA-F]+)", out):
        value = int(match[1], 16)
        result["throttled"] = [name for bit, name in THROTTLE_BITS.items() if value >> bit & 1]
    code, out, _ = run(["/bin/systemctl", "--failed", "--no-legend", "--plain"])
    result["failed_units"] = [line.split()[0] for line in out.splitlines() if line.strip()][:20]
    rows = processes()
    result["top_cpu"] = sorted(rows, key=lambda r: r["cpu_percent"], reverse=True)[:6]
    result["top_rss"] = sorted(rows, key=lambda r: r["rss_mb"], reverse=True)[:6]
    return result


def service_status(name):
    kind, target, restartable = SERVICES[name]
    row = {"name": name, "kind": kind, "unit": target, "restartable": restartable}
    if kind == "systemd":
        props = "ActiveState,SubState,MainPID,NRestarts,ExecMainStartTimestamp,MemoryCurrent"
        code, out, _ = run(["/bin/systemctl", "show", target, "--property=" + props])
        values = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
        row["running"] = values.get("ActiveState") == "active"
        row["state"] = values.get("ActiveState", "unknown") + "/" + values.get("SubState", "")
        if values.get("MainPID", "0").isdigit() and int(values["MainPID"]):
            row["pid"] = int(values["MainPID"])
        if values.get("NRestarts", "").isdigit():
            row["restart_count"] = int(values["NRestarts"])
        if values.get("ExecMainStartTimestamp"):
            row["started_at"] = values["ExecMainStartTimestamp"][:64]
        if values.get("MemoryCurrent", "").isdigit():
            row["rss_mb"] = round(int(values["MemoryCurrent"]) / 1024**2, 1)
    else:
        code, out, _ = sudo(
            ["/usr/bin/docker", "inspect", "--format", "{{json .State}} {{.RestartCount}}", target]
        )
        try:
            state_text, count = out.strip().rsplit(" ", 1)
            state = json.loads(state_text)
            row["running"] = state.get("Running") is True
            row["state"] = str(state.get("Status", "unknown"))[:32]
            row["restart_count"] = int(count)
            row["started_at"] = str(state.get("StartedAt", ""))[:64]
            health = (state.get("Health") or {}).get("Status")
            if health:
                row["docker_health"] = str(health)[:16]
        except (ValueError, AttributeError):
            row.update(running=False, state="unknown")
    return row


def status(args):
    if args:
        if args[0] not in SERVICES:
            raise ValueError("unknown service")
        return {"services": [service_status(args[0])]}
    return {"services": [service_status(name) for name in SERVICES]}


def logs(args):
    if len(args) != 2 or args[0] not in SERVICES or not args[1].isdigit():
        raise ValueError("usage: logs <service> <lines>")
    lines = max(1, min(400, int(args[1])))
    kind, target, _ = SERVICES[args[0]]
    if kind == "systemd":
        code, out, err = sudo(
            ["/bin/journalctl", "-u", target, "-n", str(lines), "--no-pager", "-o", "short-iso"]
        )
    else:
        code, out, err = sudo(["/usr/bin/docker", "logs", "--tail", str(lines), target])
        out = out + err  # docker writes the container's stderr there
    if code != 0:
        raise RuntimeError("logs unavailable")
    return {"service": args[0], "source": "journal" if kind == "systemd" else "docker",
            "lines": out.splitlines()[-lines:]}


def dig(name):
    code, out, _ = run(
        ["/usr/bin/dig", "@127.0.0.1", name, "A", "+short", "+time=2", "+tries=1"], timeout=6
    )
    answers = [line for line in out.splitlines() if re.fullmatch(r"[\d.]+", line)]
    return {"name": name, "ok": code == 0 and bool(answers), "answers": answers[:4]}


def tailscale():
    code, out, _ = run(["/usr/bin/tailscale", "status", "--json"])
    try:
        data = json.loads(out)
    except ValueError:
        return {"ok": False, "state": "unavailable"}
    me = data.get("Self") or {}
    peers = (data.get("Peer") or {}).values()
    return {
        "ok": data.get("BackendState") == "Running" and me.get("Online") is True,
        "state": str(data.get("BackendState", "unknown"))[:32],
        "online": me.get("Online") is True,
        "routes": [str(r)[:43] for r in (me.get("PrimaryRoutes") or [])][:8],
        "exit_node_offered": me.get("ExitNodeOption") is True,
        "peers_online": sum(1 for p in peers if p.get("Online")),
    }


def kuma_monitors():
    # Read-only: the newest heartbeat per active monitor.
    query = (
        "SELECT m.name, m.type, h.status, h.time FROM monitor m LEFT JOIN heartbeat h "
        "ON h.id = (SELECT id FROM heartbeat WHERE monitor_id = m.id ORDER BY id DESC LIMIT 1) "
        "WHERE m.active = 1 ORDER BY m.name"
    )
    code, out, _ = sudo(["/usr/bin/sqlite3", "-readonly", "-json", KUMA_DB, query], timeout=20)
    try:
        rows = json.loads(out or "[]")
    except ValueError:
        return {"ok": False, "reason": "kuma database unavailable"}
    names = {0: "down", 1: "up", 2: "pending", 3: "maintenance"}
    monitors = [
        {"name": str(r["name"])[:150], "type": str(r["type"])[:20],
         "status": names.get(r["status"], "unknown"), "last_check": r["time"]}
        for r in rows
    ]
    return {
        "ok": all(m["status"] in ("up", "maintenance") for m in monitors),
        "active": len(monitors),
        "not_up": [m for m in monitors if m["status"] not in ("up", "maintenance")],
    }


def updates():
    code, out, _ = run(["/usr/bin/apt", "list", "--upgradable"], timeout=30)
    packages = [line.split("/", 1)[0] for line in out.splitlines() if "/" in line][:200]
    # The lists directory changes whenever `apt-get update` fetches new indexes.
    stamps = [p for p in ("/var/lib/apt/lists", "/var/lib/apt/periodic/update-success-stamp")
              if os.path.exists(p)]
    try:
        age = round(time.time() - max(os.stat(p).st_mtime for p in stamps)) if stamps else None
    except OSError:
        age = None
    return {"count": len(packages), "packages": packages[:40], "lists_age_s": age}


def refresh_updates(args):
    """`apt-get update` only: refreshes package lists, installs nothing."""
    if args:
        raise ValueError("usage: refresh-updates")
    code, _, _ = sudo(["/usr/bin/apt-get", "update", "-qq"], timeout=180)
    return {"refreshed": code == 0, "updates": updates()}


def checks():
    return {
        "dns": [dig("example.com"), dig("sonarr.lan")],
        "tailscale": tailscale(),
        "kuma": kuma_monitors(),
        "updates": updates(),
    }


def restart(args):
    if len(args) != 1 or args[0] not in SERVICES:
        raise ValueError("unknown service")
    kind, target, restartable = SERVICES[args[0]]
    if not restartable:
        raise PermissionError("service is not restartable")
    argv = (
        ["/bin/systemctl", "restart", target]
        if kind == "systemd"
        else ["/usr/bin/docker", "restart", target]
    )
    code, _, _ = sudo(argv, timeout=90)
    time.sleep(2)
    return {"restarted": code == 0, "service": service_status(args[0])}


class Refused(Exception):
    """A request the agent understood but cannot carry out; `code` is machine-readable."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def ddp_search(host_ids=None, attempts=3, wait=0.8):
    """Find the PS5 with Sony's discovery protocol (UDP 9302). Needs no credentials.

    Answers `200 Ok` when awake and `620 Server Standby` in rest mode; a console that is
    fully off (or in rest mode without network) does not answer at all. Anything on the
    LAN can answer, so once paired only the paired console's host-id is accepted.
    """
    import socket

    probe = b"SRCH * HTTP/1.1\ndevice-discovery-protocol-version:00030010\n"
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.bind(("0.0.0.0", 0))
        sock.settimeout(0.25)
        for _ in range(attempts):
            sock.sendto(probe, ("255.255.255.255", 9302))
            deadline = time.monotonic() + wait
            while time.monotonic() < deadline:
                try:
                    data, (address, _) = sock.recvfrom(2048)
                except (TimeoutError, OSError):
                    continue
                fields = ddp_fields(data)
                if (
                    fields
                    and fields.get("host-type") == "PS5"
                    and (host_ids is None or fields.get("host-id") in host_ids)
                ):
                    return address, fields
    finally:
        sock.close()
    return None, None


def ddp_fields(data):
    try:
        lines = data.decode("utf-8", "replace").splitlines()
    except (AttributeError, ValueError):
        return None
    if not lines or not lines[0].startswith("HTTP/1.1 "):
        return None
    fields = {"status": lines[0][9:12]}
    for line in lines[1:40]:
        key, sep, value = line.partition(":")
        if sep and re.fullmatch(r"[a-z0-9-]{1,40}", key):
            fields[key] = value.strip()[:120]
    return fields


def firmware(value):
    # "13600007" -> "13.60"
    return f"{int(value[:2])}.{value[2:4]}" if re.fullmatch(r"\d{8}", value or "") else None


PS5_DIR = "/opt/switchboard-ps5"
PLAYACTOR = PS5_DIR + "/node_modules/playactor/dist/cli/index.js"
PS5_CREDENTIALS = PS5_DIR + "/credentials.json"


def paired_ids():
    """Host-ids playactor holds credentials for (keys only; values are never read out)."""
    try:
        fd = os.open(PS5_CREDENTIALS, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return set()
    try:
        info = os.fstat(fd)
        if (
            (info.st_mode & 0o170000) != 0o100000
            or info.st_uid != os.getuid()
            or info.st_mode & 0o077
            or info.st_size > 64 * 1024
        ):
            return set()
        data = json.loads(os.read(fd, 64 * 1024 + 1))
    except (OSError, ValueError, RecursionError):
        return set()
    finally:
        os.close(fd)
    if not isinstance(data, dict):
        return set()
    return {key for key in data if isinstance(key, str) and re.fullmatch(r"[0-9A-F]{12}", key)}


def ps5_state(host_ids=None):
    address, fields = ddp_search(host_ids)
    if not fields:
        return None, {"found": False, "power": "off"}
    power = {"200": "awake", "620": "rest"}.get(fields.get("status"), "unknown")
    title = None
    if power == "awake" and fields.get("running-app-titleid"):
        title = {
            "id": fields["running-app-titleid"][:40],
            "name": fields.get("running-app-name", "")[:120],
        }
    return address, {
        "found": True,
        "power": power,
        "name": fields.get("host-name", "")[:60],
        "address": address,
        "firmware": firmware(fields.get("system-version")),
        "running_title": title,
    }


def ps5(args):
    """`ps5 status|wake|standby`: wake and standby need the owner's one-time pairing."""
    if len(args) != 1 or args[0] not in ("status", "wake", "standby"):
        raise ValueError("usage: ps5 status|wake|standby")
    action, ids = args[0], paired_ids()
    bridge = {"installed": os.path.isfile(PLAYACTOR), "paired": bool(ids)}
    if action != "status" and not (bridge["installed"] and ids):
        raise Refused("not_paired", "console control is not paired")
    address, state = ps5_state(ids or None)
    if action == "status":
        return {"console": state, "bridge": bridge}
    if address is None:
        raise Refused("console_offline", "console not found on the network")
    target = "awake" if action == "wake" else "rest"
    if state["power"] == target:
        return {"action": action, "changed": False, "reached": True, "console": state}
    code, _, _ = run(
        [
            "/usr/bin/node",
            PLAYACTOR,
            action,
            "--ip",
            address,
            "--no-auth",
            "--no-open-urls",
            "--credentials",
            PS5_CREDENTIALS,
            "--timeout",
            "8000",
            "--connect-timeout",
            "15000",
        ],
        timeout=35,
    )
    if code != 0:
        raise Refused("control_failed", f"{action} was not accepted")
    deadline = time.monotonic() + 20
    while True:
        _, state = ps5_state(ids)
        if state["power"] == target or time.monotonic() > deadline:
            break
        time.sleep(1.5)
    return {"action": action, "changed": True, "reached": state["power"] == target, "console": state}


ADGUARD_URL = "http://127.0.0.1:3000"
ADGUARD_AUTH = "/opt/switchboard-pi-agent/adguard.json"  # {"user", "password"}; 0600, ours
ADGUARD_ROUTES = (
    "/control/status", "/control/stats", "/control/clients",
    "/control/querylog", "/control/filtering/status",
)
TOP_LIMIT = 8
DNS_DOMAIN_PATTERN = r"(?:\*\.)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*"
DNS_SEARCH_PATTERN = r"[A-Za-z0-9.:-]{1,100}"


def dns_domain(value):
    return (
        isinstance(value, str)
        and len(value) <= 253
        and re.fullmatch(DNS_DOMAIN_PATTERN, value) is not None
    )


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def private_json(path, limit=4096):
    """A JSON object from an owned 0600 regular file (no symlinks), or None."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if (
            (info.st_mode & 0o170000) != 0o100000
            or info.st_uid != os.getuid()
            or info.st_mode & 0o077
            or info.st_size > limit
        ):
            return None
        data = json.loads(os.read(fd, limit + 1))
    except (OSError, ValueError, RecursionError):
        return None
    finally:
        os.close(fd)
    return data if isinstance(data, dict) else None


def adguard_get(route, auth, params=None):
    """GET one fixed AdGuard Home API route on loopback with the stats account."""
    if route not in ADGUARD_ROUTES:
        raise ValueError("unsupported route")
    if params is not None and route != "/control/querylog":
        raise ValueError("unsupported parameters")
    if params is not None and (
        not isinstance(params, dict)
        or set(params) - {"limit", "search", "older_than"}
        or type(params.get("limit")) is not int
        or not 1 <= params["limit"] <= 200
        or ("search" in params and (
            not isinstance(params["search"], str)
            or re.fullmatch(DNS_SEARCH_PATTERN, params["search"]) is None
        ))
        or ("older_than" in params and (
            not isinstance(params["older_than"], str) or not 1 <= len(params["older_than"]) <= 100
        ))
    ):
        raise ValueError("unsupported parameters")
    token = base64.b64encode(f"{auth['user']}:{auth['password']}".encode()).decode()
    headers = {"Authorization": "Basic " + token}
    query = "?" + urllib.parse.urlencode(params) if params else ""
    request = urllib.request.Request(ADGUARD_URL + route + query, headers=headers)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    try:
        with opener.open(request, timeout=8) as reply:
            raw = reply.read(4 * 1024 * 1024 + 1)
            if len(raw) > 4 * 1024 * 1024:
                raise ValueError("response too large")
            data = json.loads(raw)
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            raise Refused("dns_auth_failed", "AdGuard rejected the stats account") from None
        raise Refused("dns_unavailable", "AdGuard API error") from None
    except (OSError, ValueError, RecursionError):
        raise Refused("dns_unavailable", "AdGuard API unavailable") from None
    if not isinstance(data, dict):
        raise Refused("dns_unavailable", "AdGuard API returned an unexpected shape")
    return data


def count(value):
    if type(value) in (int, float) and (not isinstance(value, float) or math.isfinite(value)):
        return int(value)
    return 0


def top(rows, names=None):
    """AdGuard top lists are [{key: count}, ...]; keep the first TOP_LIMIT as {name, count}."""
    out = []
    for row in rows if isinstance(rows, list) else []:
        if isinstance(row, dict) and len(row) == 1:
            key, value = next(iter(row.items()))
            if isinstance(key, str):
                name = str((names or {}).get(key) or key)[:253]
                out.append({"name": name, "count": count(value)})
        if len(out) == TOP_LIMIT:
            break
    return out


def client_names(auth):
    try:
        data = adguard_get("/control/clients", auth)
    except Refused:
        return {}
    names = {}
    for client in data.get("auto_clients") or []:
        if isinstance(client, dict) and isinstance(client.get("ip"), str) and client.get("name"):
            names[client["ip"]] = str(client["name"])
    for client in data.get("clients") or []:  # owner-named clients win over discovered names
        if isinstance(client, dict) and client.get("name"):
            for ident in client.get("ids") or []:
                if isinstance(ident, str):
                    names[ident] = str(client["name"])
    return names


def dns_stats(args):
    """`dns-stats`: AdGuard Home's own dashboard numbers, read with a dedicated account."""
    if args:
        raise ValueError("usage: dns-stats")
    auth = dns_auth()
    status = adguard_get("/control/status", auth)
    stats = adguard_get("/control/stats", auth)
    units = stats.get("time_units") if stats.get("time_units") in ("hours", "days") else "days"
    queries_series = [count(x) for x in (stats.get("dns_queries") or [])][:744]
    blocked_series = [count(x) for x in (stats.get("blocked_filtering") or [])][:744]
    queries = count(stats.get("num_dns_queries"))
    blocked = count(stats.get("num_blocked_filtering"))
    avg = stats.get("avg_processing_time")
    days = len(queries_series) if units == "days" else round(len(queries_series) / 24, 2)
    return {
        "protection_enabled": status.get("protection_enabled") is True,
        # Milliseconds left on a timed pause (AdGuard's protection_disabled_duration), else 0.
        "paused_ms": count(status.get("protection_disabled_duration")),
        "version": str(status.get("version") or "")[:40],
        "time_units": units,
        "period_days": days,
        "queries": queries,
        "blocked": blocked,
        "blocked_percent": round(blocked / queries * 100, 1) if queries else 0.0,
        "avg_ms": round(avg * 1000, 1) if isinstance(avg, (int, float)) and avg >= 0 else 0.0,
        "series": {"queries": queries_series, "blocked": blocked_series},
        "top_blocked": top(stats.get("top_blocked_domains")),
        "top_queried": top(stats.get("top_queried_domains")),
        "top_clients": top(stats.get("top_clients"), client_names(auth)),
    }


def adguard_protection(auth, enabled, minutes=0):
    """POST AdGuard's one protection route: on, or off for a bounded number of minutes."""
    body = {"enabled": enabled}
    if not enabled:
        body["duration"] = minutes * 60_000  # AdGuard turns protection back on by itself
    token = base64.b64encode(f"{auth['user']}:{auth['password']}".encode()).decode()
    request = urllib.request.Request(
        ADGUARD_URL + "/control/protection",
        data=json.dumps(body).encode(),
        headers={"Authorization": "Basic " + token, "Content-Type": "application/json"},
        method="POST",
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(request, timeout=8) as reply:
            reply.read(65536)
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            raise Refused("dns_auth_failed", "AdGuard rejected the stats account") from None
        raise Refused("dns_unavailable", "AdGuard API error") from None
    except OSError:
        raise Refused("dns_unavailable", "AdGuard API unavailable") from None


def dns_auth():
    auth = private_json(ADGUARD_AUTH)
    if not auth or not all(isinstance(auth.get(k), str) and auth[k] for k in ("user", "password")):
        raise Refused("dns_not_configured", "AdGuard stats account is not set up")
    return auth


def dns_pause(args):
    """`dns-pause <minutes>`: stop blocking for 1-120 minutes; AdGuard resumes on its own."""
    if len(args) != 1 or not args[0].isdigit() or not 1 <= int(args[0]) <= 120:
        raise ValueError("usage: dns-pause <1-120>")
    auth = dns_auth()
    adguard_protection(auth, False, int(args[0]))
    status = adguard_get("/control/status", auth)
    return {
        "protection_enabled": status.get("protection_enabled") is True,
        "paused_minutes": int(args[0]),
    }


def dns_resume(args):
    """`dns-resume`: turn blocking back on now."""
    if args:
        raise ValueError("usage: dns-resume")
    auth = dns_auth()
    adguard_protection(auth, True)
    status = adguard_get("/control/status", auth)
    return {"protection_enabled": status.get("protection_enabled") is True, "paused_minutes": 0}


def adguard_post(route, auth, body):
    """Only the two fixed filtering writes; never follow redirects or use proxies."""
    if route not in ("/control/filtering/set_rules", "/control/filtering/refresh"):
        raise ValueError("unsupported route")
    token = base64.b64encode(f"{auth['user']}:{auth['password']}".encode()).decode()
    request = urllib.request.Request(
        ADGUARD_URL + route,
        data=json.dumps(body).encode(),
        headers={"Authorization": "Basic " + token, "Content-Type": "application/json"},
        method="POST",
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    try:
        with opener.open(request, timeout=60 if route.endswith("/refresh") else 8) as reply:
            raw = reply.read(65537)
            if len(raw) > 65536:
                raise ValueError("response too large")
            # set_rules may have an empty response; refresh returns JSON.
            data = json.loads(raw) if raw and route.endswith("/refresh") else {}
            if not isinstance(data, dict):
                raise ValueError("invalid response")
            return data
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            raise Refused("dns_auth_failed", "AdGuard rejected the stats account") from None
        raise Refused("dns_unavailable", "AdGuard API error") from None
    except (OSError, ValueError, RecursionError):
        raise Refused("dns_unavailable", "AdGuard API unavailable") from None


def text(value, limit):
    return value[:limit] if isinstance(value, str) else ""


def bounded_rows(rows, limit, budget=180000):
    """Keep output below the SSH pipe budget, including JSON escaping."""
    out, size = [], 0
    for row in rows[:limit]:
        size += len(json.dumps(row).encode()) + 2
        if size > budget:
            break
        out.append(row)
    return out


def query_rules(row):
    """Prefer the current array, including an empty one; accept legacy fields only as fallback."""
    matches = row.get("rules")
    if matches is None:
        rule = row.get("rule")
        return (
            [{"text": rule, "filter_list_id": row.get("filterId")}]
            if isinstance(rule, str) and rule else []
        )
    if not isinstance(matches, list):
        raise Refused("dns_unavailable", "AdGuard query log returned an unexpected shape")
    return matches


def project_query(row):
    question = row.get("question") or {}
    client = row.get("client_info") or {}
    matches = query_rules(row)
    if not isinstance(question, dict) or not isinstance(client, dict):
        raise Refused("dns_unavailable", "AdGuard query log returned an unexpected shape")
    return {
        "time": text(row.get("time"), 40),
        "client": {"ip": text(row.get("client"), 45), "name": text(client.get("name"), 120)},
        "question": {"domain": text(question.get("name"), 253), "type": text(question.get("type"), 20)},
        "answer_status": text(row.get("status"), 40),
        "reason": text(row.get("reason"), 120),
        "rules": [{"rule": text(match.get("text"), 512), "filter_id": count(match.get("filter_list_id"))}
                  for match in matches[:8] if isinstance(match, dict)],
    }, len(matches) > 8


def dns_querylog(args):
    if (
        len(args) not in (2, 3)
        or re.fullmatch(r"[0-9]{1,3}", args[0]) is None
        or not 1 <= int(args[0]) <= 200
        or args[1] not in ("all", "blocked")
        or (len(args) == 3 and re.fullmatch(DNS_SEARCH_PATTERN, args[2]) is None)
    ):
        raise ValueError("usage: dns-querylog <1-200> <all|blocked> [search]")
    limit = int(args[0])
    # v1.0.0 removed server-side status filtering. These parameters also work on v0.107.x.
    page_size = 200 if args[1] == "blocked" else limit
    params = {"limit": page_size}
    if len(args) == 3:
        params["search"] = args[2]
    auth = dns_auth()
    queries, shortened = [], False
    cursors = set()
    for page in range(5):
        data = adguard_get("/control/querylog", auth, dict(params))
        rows = data.get("data")
        if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
            raise Refused("dns_unavailable", "AdGuard query log returned an unexpected shape")
        if not rows:
            break
        shortened |= len(rows) > page_size
        rows = rows[:page_size]
        cursor = data.get("oldest") or rows[-1].get("time")
        if isinstance(cursor, str) and cursor in cursors:
            # An ignored/repeated cursor must not duplicate results or loop forever.
            shortened = True
            break
        for row in rows:
            reason = row.get("reason")
            # NotFilteredAllowList, NotFilteredNotFound and Rewrite* are not blocked.
            if args[1] == "blocked" and not (isinstance(reason, str) and reason.startswith("Filtered")):
                continue
            query, clipped = project_query(row)
            shortened |= clipped
            queries.append(query)
            if len(queries) == limit:
                break
        if len(queries) == limit:
            shortened = True
            break
        if not isinstance(cursor, str) or not 1 <= len(cursor) <= 100 or page == 4:
            shortened = True
            break
        cursors.add(cursor)
        params["older_than"] = cursor
    result = bounded_rows(queries, limit)
    return {"queries": result, "limit": limit, "truncated": shortened or len(result) < len(queries)}


def filtering_state(auth):
    data = adguard_get("/control/filtering/status", auth)
    rules = data.get("user_rules")
    if not isinstance(rules, list) or not all(isinstance(rule, str) for rule in rules):
        raise Refused("dns_unavailable", "AdGuard user rules returned an unexpected shape")
    return data


def dns_rules(args):
    if args:
        raise ValueError("usage: dns-rules")
    data = filtering_state(dns_auth())
    filters = data.get("filters")
    if not isinstance(filters, list) or not all(isinstance(item, dict) for item in filters):
        raise Refused("dns_unavailable", "AdGuard filter lists returned an unexpected shape")
    lists = []
    for item in filters[:100]:
        try:
            url = item.get("url")
            host = urllib.parse.urlsplit(url).hostname or "" if isinstance(url, str) else ""
        except ValueError:
            host = ""
        lists.append({
            "id": count(item.get("id")), "name": text(item.get("name"), 120),
            "url_host": text(host, 253), "enabled": item.get("enabled") is True,
            "rules_count": max(0, count(item.get("rules_count"))),
            "last_updated": text(item.get("last_updated"), 40),
        })
    shown_lists = bounded_rows(lists, 100, budget=40000)
    # AdGuard reports "no custom rules" as [""]; blank lines are not rules.
    rules = [rule for rule in data["user_rules"] if rule.strip()]
    shown = bounded_rows([rule[:512] for rule in rules[:1000]], 1000, budget=140000)
    return {
        "enabled": data.get("enabled") is True, "user_rules": shown,
        "user_rules_count": len(rules), "filters": shown_lists,
        "truncated": len(shown) < len(rules) or len(shown_lists) < len(filters)
        or any(len(rule) > 512 for rule in rules),
    }


def rule_domain(rule):
    """Extract only an exact hostname target; preserve regexes and other advanced rules."""
    rule = rule.strip()
    if not rule or rule.startswith(("!", "#")):
        return None
    if rule.startswith("@@"):
        rule = rule[2:]
    if rule.startswith("||"):
        match = re.fullmatch(r"\|\|([^\^]+)\^(?:\$[^\r\n]+)?", rule)
        rule = match[1] if match else ""
    else:
        parts = rule.split()
        if len(parts) == 2 and parts[0] in ("0.0.0.0", "127.0.0.1", "::", "::1"):
            rule = parts[1]
    return rule.lower() if dns_domain(rule) else None


def dns_rule(args):
    if len(args) != 2 or args[0] not in ("allow", "block", "remove") or not dns_domain(args[1]):
        raise ValueError("usage: dns-rule <allow|block|remove> <domain>")
    action, domain = args[0], args[1].lower()
    auth = dns_auth()
    rules = filtering_state(auth)["user_rules"]
    selected = [rule for rule in rules if rule_domain(rule) == domain]
    desired = ("@@" if action == "allow" else "") + "||" + domain + "^"
    edited = [rule for rule in rules if rule_domain(rule) != domain]
    if action != "remove":
        edited.append(desired)
    changed = selected != ([] if action == "remove" else [desired])
    if changed:
        adguard_post("/control/filtering/set_rules", auth, {"rules": edited})
    return {
        "domain": domain, "action": action,
        "rule": (text(selected[0], 512) if selected else "") if action == "remove" else desired,
        "changed": changed, "rules_count": len(edited) if changed else len(rules),
    }


def dns_filters_refresh(args):
    if args:
        raise ValueError("usage: dns-filters-refresh")
    data = adguard_post("/control/filtering/refresh", dns_auth(), {"whitelist": False})
    if type(data.get("updated")) is not int or data["updated"] < 0:
        raise Refused("dns_unavailable", "AdGuard refresh returned an unexpected shape")
    return {"updated": data["updated"]}


COMMANDS = {
    "dns-querylog": dns_querylog,
    "dns-rules": dns_rules,
    "dns-rule": dns_rule,
    "dns-filters-refresh": dns_filters_refresh,
    "dns-stats": dns_stats,
    "dns-pause": dns_pause,
    "dns-resume": dns_resume,
    "ps5": ps5,
    "snapshot": lambda args: snapshot(),
    "status": status,
    "logs": logs,
    "checks": lambda args: checks(),
    "restart": restart,
    "refresh-updates": refresh_updates,
    "version": lambda args: {"version": VERSION},
}


def main():
    request = os.environ.get("SSH_ORIGINAL_COMMAND", "").split(" ")
    dns_request = request[0] in ("dns-querylog", "dns-rule")
    if request[0] not in COMMANDS or (not dns_request and (len(request) > 3 or any(
        not re.fullmatch(r"[a-z0-9_-]{1,40}", part) for part in request
    ))):
        print(json.dumps({"ok": False, "error": "unsupported request"}))
        return 2
    try:
        result = COMMANDS[request[0]](request[1:])
    except PermissionError as exc:
        print(json.dumps({"ok": False, "error": str(exc), "code": "not_allowed"}))
        return 3
    except Refused as exc:
        print(json.dumps({"ok": False, "error": str(exc), "code": exc.code}))
        return 3
    except (ValueError, RuntimeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 2
    print(json.dumps({"ok": True, "agent_version": VERSION, **result}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
